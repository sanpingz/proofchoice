# Pin the public registry for this project.
#
# Without this, an install run on a machine with a private registry
# configured bakes internal `resolved` URLs into package-lock.json.
# The lockfile then installs fine locally and fails on any build
# machine that cannot reach those hosts — on Vercel it surfaces as
# the opaque "npm error Exit handler never called!".
#
# Every dependency here is public, so this is always correct.
registry=https://registry.npmjs.org/
